{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["syd1"],
  "crons": [
    {
      "path": "/api/cron/legal-deadlines",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/strava-token-refresh",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/gym/sync/strava/manual",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/cron/life-morning",
      "schedule": "15 19 * * *"
    }
  ]
}
